DATABASE_URL=sqlite:///mogakco.local.db
AUTH_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_LOGIN_CODE_TTL_SECONDS=60
AUTH_API_BASE_URL=http://127.0.0.1:8000

# 실제 앱 링크·소셜 로그인 검증에는 공개 HTTPS 개발 도메인이 필요합니다.
AUTH_APP_LINK_BASE_URL=https://link-dev.example.com
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
KAKAO_CLIENT_ID=replace-with-kakao-client-id
KAKAO_CLIENT_SECRET=replace-with-kakao-client-secret

# 로컬에서는 개발용 버킷과 AWS_* 자격 증명이 필요합니다.
S3_BUCKET=mogakco-media-dev
S3_REGION=ap-northeast-2
S3_PUBLIC_BASE_URL=https://mogakco-media-dev.s3.ap-northeast-2.amazonaws.com
S3_UPLOAD_TTL_SECONDS=300
S3_MAX_UPLOAD_BYTES=5242880
