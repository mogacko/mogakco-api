# 로컬은 이 파일을 .env.local로 복사해서 쓴다.
# 스테이징·운영은 파일 대신 배포 환경의 비밀값 저장소로 같은 변수를 주입한다.

# 운영은 postgresql+psycopg://user:password@host:5432/mogakco
DATABASE_URL=sqlite:///mogakco.local.db

# 최소 32자 이상의 무작위 값
AUTH_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_LOGIN_CODE_TTL_SECONDS=60

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# 앱이 발급받는 Google ID token의 backend audience(Web OAuth client ID)
GOOGLE_OAUTH_CLIENT_IDS=replace-with-google-web-client-id
APPLE_CLIENT_IDS=replace-with-ios-bundle-id,replace-with-android-service-id
KAKAO_CLIENT_ID=replace-with-kakao-client-id
KAKAO_CLIENT_SECRET=replace-with-kakao-client-secret

# 필수. 가입 코드가 여기 저장되므로 없으면 소셜 가입이 되지 않는다.
# 자동완성 캐시도 같은 Redis를 쓰지만 그쪽은 없어도 PostgreSQL 집계로 돈다.
# 띄우려면: docker run -d -p 6379:6379 redis:7-alpine
REDIS_URL=redis://localhost:6379/0
KEYWORD_CACHE_TTL_SECONDS=86400

# 로컬에서도 개발용 버킷과 AWS_* 자격 증명이 필요하다.
# 운영 자격 증명은 인스턴스 역할이나 AWS_* 표준 환경 변수로 주입한다.
S3_BUCKET=mogakco-media-dev
S3_REGION=ap-northeast-2
S3_PUBLIC_BASE_URL=https://mogakco-media-dev.s3.ap-northeast-2.amazonaws.com
S3_UPLOAD_TTL_SECONDS=300
S3_MAX_UPLOAD_BYTES=5242880

# 참조 없는 이미지를 지우기까지 두는 시간 (app.images.cleanup)
MEDIA_ORPHAN_AGE_HOURS=24
