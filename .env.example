DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mogakco

# 최소 32자 이상의 무작위 값
AUTH_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_LOGIN_CODE_TTL_SECONDS=60
AUTH_API_BASE_URL=https://api.example.com
AUTH_APP_LINK_BASE_URL=https://link.example.com

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
KAKAO_CLIENT_ID=replace-with-kakao-client-id
KAKAO_CLIENT_SECRET=replace-with-kakao-client-secret

# 자격 증명은 인스턴스 역할이나 AWS_* 표준 환경 변수로 주입한다.
S3_BUCKET=mogakco-media
S3_REGION=ap-northeast-2
S3_PUBLIC_BASE_URL=https://cdn.example.com
S3_UPLOAD_TTL_SECONDS=300
S3_MAX_UPLOAD_BYTES=5242880
# 참조 없는 이미지를 지우기까지 두는 시간 (app.images.cleanup)
MEDIA_ORPHAN_AGE_HOURS=24
