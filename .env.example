DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mogakco

# 최소 32자 이상의 무작위 값
AUTH_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_LOGIN_CODE_TTL_SECONDS=60
AUTH_API_BASE_URL=https://api.example.com
AUTH_APP_LINK_BASE_URL=https://link.example.com

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
KAKAO_CLIENT_ID=replace-with-kakao-client-id
KAKAO_CLIENT_SECRET=replace-with-kakao-client-secret
